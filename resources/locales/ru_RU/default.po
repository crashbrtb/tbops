#. Game tournaments: imported rankings, reward split, API tokens
msgid "Game tournament (imported score)"
msgstr "Турнир в игре (импортированные очки)"

msgid "The ranking is read from the game by the EventUploader and the rewards below are split among the players."
msgstr "Рейтинг считывается из игры программой EventUploader, а награды ниже делятся между игроками."

msgid "Points"
msgstr "Очки"

msgid "Proportional to the points"
msgstr "Пропорционально очкам"

msgid "Equal parts"
msgstr "Поровну"

msgid "Give the leftover to the best placed"
msgstr "Остаток — лучшим по месту"

msgid "Keep the leftover with the clan"
msgstr "Остаток оставить клану"

msgid "{0} x {1} ({2})"
msgstr "{0} x {1} ({2})"

msgid "Add at least one reward to split among the players."
msgstr "Добавьте хотя бы одну награду для распределения между игроками."

msgid "Say what is being handed out."
msgstr "Укажите, что выдаётся."

msgid "The quantity must be a whole number."
msgstr "Количество должно быть целым числом."

msgid "The quantity must be at least 1."
msgstr "Количество должно быть не меньше 1."

msgid "Choose how the reward is split."
msgstr "Выберите способ распределения награды."

msgid "Give the token a name, such as the computer it will be used on."
msgstr "Дайте токену имя, например компьютер, на котором он будет использоваться."

msgid "Another member already has this game player id."
msgstr "Этот игровой ID игрока уже есть у другого участника."

msgid "The ranking must have at least one player."
msgstr "В рейтинге должен быть хотя бы один игрок."

msgid "A clan ranking has at most {0} players; {1} were sent."
msgstr "В рейтинге клана не более {0} игроков; отправлено {1}."

msgid "Line {0} is not a player."
msgstr "Строка {0} не является игроком."

msgid "Line {0}: the position must be a whole number from 1."
msgstr "Строка {0}: позиция должна быть целым числом от 1."

msgid "Line {0}: position {1} appears twice."
msgstr "Строка {0}: позиция {1} встречается дважды."

msgid "Line {0}: the name must have 1 to {1} characters."
msgstr "Строка {0}: имя должно содержать от 1 до {1} символов."

msgid "Line {0}: the points must be a whole number of 0 or more."
msgstr "Строка {0}: очки должны быть целым числом не меньше 0."

msgid "Line {0}: the player id must be a positive whole number."
msgstr "Строка {0}: ID игрока должен быть положительным целым числом."

msgid "Line {0}: player id {1} appears twice."
msgstr "Строка {0}: ID игрока {1} встречается дважды."

msgid "Unknown capture method."
msgstr "Неизвестный способ получения данных."

msgid "The tournament date is not a valid date."
msgstr "Дата турнира указана неверно."

msgid "{0} player(s) are not linked to a member: {1}. They still receive their share; link them to keep the history together."
msgstr "{0} игрок(ов) не связаны с участником: {1}. Свою долю они всё равно получат; свяжите их, чтобы история не разделялась."

msgid "{0} player(s) were linked by name. Confirm them: when the result is published their game id is saved on the member."
msgstr "{0} игрок(ов) связаны по имени. Проверьте: при публикации их игровой ID сохранится у участника."

msgid "The positions are not 1 to {0} without gaps: a part of the ranking may be missing."
msgstr "Позиции идут не от 1 до {0} без пропусков: возможно, часть рейтинга отсутствует."

msgid "Points are not in descending order at: {0}. Check for a reading error."
msgstr "Очки идут не по убыванию на: {0}. Проверьте, нет ли ошибки чтения."

msgid "Different players share a name: {0}. They are told apart by their game id."
msgstr "У разных игроков одинаковое имя: {0}. Их различают по игровому ID."

msgid "Points were corrected by hand for {0} player(s)."
msgstr "Очки исправлены вручную у {0} игрок(ов)."

msgid "This event has no reward to split. Add one before publishing."
msgstr "У этого события нет награды для распределения. Добавьте её перед публикацией."

msgid "Only a draft can be changed. Unpublish the result first."
msgstr "Изменить можно только черновик. Сначала снимите результат с публикации."

msgid "This ranking is not a draft of this event."
msgstr "Этот рейтинг не является черновиком данного события."

msgid "Event #{0} does not take an imported ranking."
msgstr "Событие #{0} не принимает импортированный рейтинг."

msgid "The result of event #{0} is already published. Unpublish it to send a new ranking."
msgstr "Результат события #{0} уже опубликован. Снимите его с публикации, чтобы отправить новый рейтинг."

msgid "Nobody qualifies for \"{0}\": check the eligible players and the minimum points."
msgstr "Никто не подходит для «{0}»: проверьте участвующих игроков и минимум очков."

msgid "This event has no published result yet."
msgstr "У этого события ещё нет опубликованного результата."

msgid "Only game tournaments have a ranking to review."
msgstr "Рейтинг для проверки есть только у турниров из игры."

msgid "There is no draft ranking to change."
msgstr "Нет черновика рейтинга для изменения."

msgid "The result of event #{0} was published: {1} player(s)."
msgstr "Результат события #{0} опубликован: {1} игрок(ов)."

msgid "{0} change(s) saved. The shares below are recalculated."
msgstr "Сохранено изменений: {0}. Доли ниже пересчитаны."

msgid "administrative"
msgstr "служебный"

msgid "This event has no published result."
msgstr "У этого события нет опубликованного результата."

msgid "The result of event #{0} is a draft again and no longer public."
msgstr "Результат события #{0} снова черновик и больше не опубликован."

msgid "Event #{0} was created from #{1}. Check the name and the date."
msgstr "Событие #{0} создано на основе #{1}. Проверьте название и дату."

msgid "The event could not be duplicated: {0}"
msgstr "Не удалось скопировать событие: {0}"

msgid "Choose the ranking CSV file to upload."
msgstr "Выберите CSV-файл рейтинга для загрузки."

msgid "The file is too large for a ranking of at most {0} players."
msgstr "Файл слишком велик для рейтинга максимум из {0} игроков."

msgid "The ranking was not accepted: {0}"
msgstr "Рейтинг не принят: {0}"

msgid "Ranking with {0} player(s) received. Review it below."
msgstr "Получен рейтинг из {0} игрок(ов). Проверьте его ниже."

msgid "This ranking is the same as the current draft; nothing changed."
msgstr "Этот рейтинг совпадает с текущим черновиком; ничего не изменилось."

msgid "Send the API token in the Authorization header: Bearer <token>."
msgstr "Передайте API-токен в заголовке Authorization: Bearer <token>."

msgid "This API token is invalid, expired or revoked."
msgstr "Этот API-токен недействителен, истёк или отозван."

msgid "Only an active administrator can use the uploader."
msgstr "Загрузчиком может пользоваться только активный администратор."

msgid "Event not found."
msgstr "Событие не найдено."

msgid "Send the ranking as a JSON body."
msgstr "Отправьте рейтинг в теле запроса в формате JSON."

msgid "The ranking was not accepted."
